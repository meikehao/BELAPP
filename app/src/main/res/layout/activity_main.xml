<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="电量蓝牙监控"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="12dp" />

        <!-- 电量卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#F7F5FF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前电量"
                    android:textSize="13sp"
                    android:textColor="#5C4E8A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvBatteryLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="#3A2A80" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#3A2A80"
                        android:layout_marginStart="3dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvChargingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="#3A2A80"
                        android:background="#E2DCFF"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbBattery"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="10dp"
                    android:progressTint="#6C48FF"
                    android:progressBackgroundTint="#D6D0EC"
                    android:indeterminate="false"
                    android:max="100" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 晨钟酱风格：功率卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="18dp"
                android:paddingBottom="14dp"
                android:paddingHorizontal="16dp">

                <!-- 顶部标签 + 单位切换 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="功率"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/tvPowerContext"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="未充电时显示整机功耗"
                        android:textSize="10sp"
                        android:textColor="#999999" />
                </LinearLayout>

                <!-- 功率大数字（W） -->
                <TextView
                    android:id="@+id/tvPowerW"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="0.00 W"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:fontFamily="monospace" />

                <!-- 单位切换（uA/mA）+ 电流 + 电压 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 电流单位切换按钮 -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnUnitToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:textSize="11sp"
                        android:textColor="#1E4787"
                        android:background="@drawable/bg_btn_blue"
                        android:text="单位: mA" />

                    <!-- 电流值 -->
                    <TextView
                        android:id="@+id/tvCurrent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:text="0 mA"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:fontFamily="monospace" />

                    <!-- 电压值 -->
                    <TextView
                        android:id="@+id/tvVoltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 mV"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- 电池健康 + 技术（小字） -->
                <TextView
                    android:id="@+id/tvBatteryTech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Li-ion · 健康良好 · 3835 mV"
                    android:textSize="10sp"
                    android:textColor="#AAAAAA" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 蓝牙状态 + 操作 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#F6F6F7"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="蓝牙"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111111" />

                    <TextView
                        android:id="@+id/tvBleStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="未连接"
                        android:textSize="13sp"
                        android:textColor="#777777"
                        android:gravity="end" />

                    <View
                        android:id="@+id/vBleStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_dot" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConnectedDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#777777" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnScan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingVertical="10dp"
                        android:textColor="#3A2A80"
                        android:textSize="14sp"
                        android:includeFontPadding="false"
                        android:text="扫描"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_btn_purple" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDisconnect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingVertical="10dp"
                        android:textColor="#8C2424"
                        android:textSize="14sp"
                        android:includeFontPadding="false"
                        android:text="断开"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_btn_red" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 蓝牙设备列表（限制高度 + 可滚动） -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="发现的设备（点击连接）"
                        android:textSize="13sp"
                        android:textColor="#333333"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeviceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#999999" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDevices"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="vertical"
                    android:fadingEdge="vertical"
                    android:fadingEdgeLength="16dp"
                    android:requiresFadingEdge="vertical"
                    android:background="#FAFAFA" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 阈值配置（双阈值：开 + 关） -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="电量阈值"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#111111" />

                <!-- 开阈值 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="停充阈值"
                        android:textSize="12sp"
                        android:textColor="#1E4787"
                        android:minWidth="72dp" />

                    <EditText
                        android:id="@+id/etOpenThreshold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="80"
                        android:inputType="number"
                        android:text="80"
                        android:textSize="14sp"
                        android:textColor="#111111"
                        android:background="#F1F1F3"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textColorHint="#999999"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textSize="13sp"
                        android:textColor="#555555" />
                </LinearLayout>

                <!-- 关阈值 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开充阈值"
                        android:textSize="12sp"
                        android:textColor="#8A6420"
                        android:minWidth="72dp" />

                    <EditText
                        android:id="@+id/etCloseThreshold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="20"
                        android:inputType="number"
                        android:text="20"
                        android:textSize="14sp"
                        android:textColor="#111111"
                        android:background="#F1F1F3"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textColorHint="#999999"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textSize="13sp"
                        android:textColor="#555555" />
                </LinearLayout>

                <!-- 应用按钮 + 说明 -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSetThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="46dp"
                    android:paddingVertical="9dp"
                    android:textColor="#157045"
                    android:textSize="14sp"
                    android:includeFontPadding="false"
                    android:text="应用阈值"
                    android:background="@drawable/bg_btn_green" />

                <TextView
                    android:id="@+id/tvThresholdInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="当前：充到 80% 自动停充，掉到 20% 自动开充"
                    android:textSize="11sp"
                    android:textColor="#888888" />

                <!-- 手动开关按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTestSend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp"
                        android:textColor="#1E4787"
                        android:textSize="14sp"
                        android:includeFontPadding="false"
                        android:text="开充电"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_btn_blue" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSendStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="4dp"
                        android:textColor="#8A6420"
                        android:textSize="14sp"
                        android:includeFontPadding="false"
                        android:text="关充电"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_btn_yellow" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
