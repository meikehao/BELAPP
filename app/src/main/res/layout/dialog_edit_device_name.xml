<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_ios_dialog_card"
    android:paddingHorizontal="24dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp"
    android:layout_marginHorizontal="48dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="修改设备广播名"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:gravity="center" />

    <!-- 副标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="ESP32-C3 对外广播的蓝牙名称"
        android:textSize="12sp"
        android:textColor="#8E8E93"
        android:gravity="center" />

    <!-- 输入框 -->
    <EditText
        android:id="@+id/etIosInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="广播名"
        android:maxLength="20"
        android:inputType="text"
        android:singleLine="true"
        android:textSize="15sp"
        android:textColor="#111111"
        android:textColorHint="#8E8E93"
        android:background="@drawable/bg_ios_input"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp" />

    <!-- 按钮横排 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIosCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="取消"
            android:textSize="15sp"
            android:textColor="#007AFF"
            android:includeFontPadding="false"
            android:background="@drawable/bg_ios_btn_cancel" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIosSave"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="保存"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false"
            android:background="@drawable/bg_ios_btn_primary" />
    </LinearLayout>

</LinearLayout>
